# OMX4 F test model (current: wrist-only). Later set top_wrist and change policy.
OMX4_CAMERA_MODE=wrist_only
OMX4_POLICY_PATH=outputs/train/warehouse_item_f_129_merged_wrist_only_act_300k/checkpoints/250000/pretrained_model
OMX4_LEROBOT_ROBOT_ID=omx_f_test_follower_arm
OMX4_FOLLOWER_PORT=/dev/serial/by-id/usb-ROBOTIS_OpenRB-150_7E7FE4BC503059384C2E3120FF080E2D-if00
OMX4_WRIST_CAMERA=/dev/v4l/by-id/usb-Innomaker_Innomaker-U20CAM-1080p-S1_SN0001-video-index0
# Later with a newly trained top+wrist checkpoint:
# OMX4_CAMERA_MODE=top_wrist
# OMX4_POLICY_PATH=outputs/train/<new_checkpoint>/pretrained_model
# OMX4_TOP_CAMERA_TYPE=opencv
# OMX4_TOP_CAMERA=/dev/v4l/by-id/<top-camera>-video-index0
# or, for Intel RealSense: OMX4_TOP_CAMERA_TYPE=intelrealsense; OMX4_TOP_CAMERA_SERIAL=<serial>
# Note: image keys must match checkpoint (wrist, top). Physical job success needs validation.
# OMX_CPU_THREADS=2
# Persistent preloaded F: defaults, change only if needed.
# OMX_CPU_THREADS=4
# OMX_STARTUP_TIMEOUT_S=120
# OMX_UNLOAD_TIMEOUT_S=900
