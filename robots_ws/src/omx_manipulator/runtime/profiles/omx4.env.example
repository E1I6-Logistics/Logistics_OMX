# OMX4 unload station (RealSense RGB + OpenCV wrist camera)
# This file is copied to ~/.config/logistics_omx/profile.env on first install.
# Fill in the four required values below using this Pi's actual hardware/model.
# OMX4_POLICY_PATH=outputs/train/<actual-model>/checkpoints/<step>/pretrained_model
# OMX4_FOLLOWER_PORT=/dev/serial/by-id/usb-ROBOTIS_OpenRB-150_<actual-id>-if00
# OMX4_FRONT_CAMERA_SERIAL=<actual-realsense-serial>
# OMX4_WRIST_CAMERA=/dev/v4l/by-id/<actual-wrist-camera>-video-index0
# The ACT checkpoint must expect this image key (top or front).
# OMX4_CAMERA_KEY=top
# E_IDLE_COMPLETE_HOLD_S=15
# OMX_CPU_THREADS=2
